{
  "name": "beacon-brawl",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "assets": "node scripts/build-rig.mjs",
    "build:server": "esbuild server/server.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist-server/server.mjs",
    "build:all": "npm run build && npm run build:server",
    "start": "node dist-server/server.mjs",
    "portraits": "node scripts/render-portraits.cjs"
  },
  "dependencies": {
    "@pixiv/three-vrm": "^3.5.5",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/node": "^22.20.5",
    "@types/three": "^0.170.0",
    "esbuild": "^0.27.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "engines": {
    "node": ">=22"
  }
}
