{
  "name": "capball",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "fetch-assets": "node scripts/fetch-assets.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "sim": "esbuild test/sim.ts --bundle --platform=node --format=esm --outfile=.asset-cache/sim.mjs --log-level=warning --define:import.meta.env.BASE_URL='\"/\"' && node .asset-cache/sim.mjs",
    "build:artifact": "tsc --noEmit && VITE_MODEL_EXT=json VITE_NO_SE=$([ -d public/assets/se ] && [ \"$(ls public/assets/se)\" ] && echo 0 || echo 1) vite build && node scripts/build-artifact.mjs"
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/three": "^0.170.0",
    "jpeg-js": "^0.4.4",
    "meshoptimizer": "^1.3.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.8"
  },
  "description": "キャップ野球ゲーム（ブラウザ・スマホ対応）"
}
