{
  "name": "dice-kingdom",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "icons": "node scripts/extract-icons.mjs",
    "dev": "vite",
    "build": "node scripts/fetch-ui.mjs && tsc --noEmit && vite build && node scripts/prune-models.mjs dist",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "sim": "node --experimental-strip-types scripts/simulate.ts",
    "ui-assets": "node scripts/fetch-ui.mjs",
    "predev": "node scripts/fetch-ui.mjs"
  },
  "dependencies": {
    "cannon-es": "0.20.0",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@types/node": "22.13.0",
    "@types/three": "0.170.0",
    "typescript": "5.9.3",
    "vite": "7.3.8"
  }
}
