{
  "name": "scratch-map",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "npm run dev -w server & npm run dev -w web",
    "dev:server": "npm run dev -w server",
    "dev:web": "npm run dev -w web",
    "build": "npm run build:server && npm run build:web",
    "build:server": "npm run build -w server",
    "build:web": "npm run build -w web",
    "start:server": "npm run start -w server",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w web",
    "test": "vitest run"
  },
  "dependencies": {
    "h3-js": "^4.5.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=20"
  }
}
