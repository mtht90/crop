# ローカル開発用（server/.env にコピーして使う）
DATABASE_URL=postgres://postgres@localhost:5432/scratchmap
# フロントのオリジン（CORS・マジックリンク・パスキー）
APP_ORIGIN=http://localhost:5173
# 外部アプリ連携 URL の生成に使う API の公開 URL（開発時は Vite のプロキシ経由でも可）
PUBLIC_API_URL=http://localhost:5173
# メールを送らずにログインリンクを画面に出す（ローカル専用。本番では絶対に true にしない）
DEV_MAGIC_LINK=true
# スマホ実機で LAN の HTTPS URL から開く場合などに追加で許可するオリジン（カンマ区切り）
# CORS_EXTRA_ORIGINS=https://192.168.1.10:5173
# RESEND_API_KEY=
# MAIL_FROM=Scratch Map <login@example.com>
