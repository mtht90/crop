{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "geojson"],
    "lib": ["ES2023"],
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true
  },
  "include": ["src", "../shared", "../tests"]
}
